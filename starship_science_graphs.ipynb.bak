   "source": [
    "from matplotlib.ticker import MaxNLocator\n",
    "\n",
    "\n",
    "\n",
    "prop_mass = 1600\n",
    "tanker_prop = 100\n",
    "refuels_per_ship = prop_mass/tanker_prop\n",
    "\n",
    "\n",
    "dry_mass = 120\n",
    "isp=370\n",
    "DV_saved = np.linspace(0,2900,50)\n",
    "\n",
    "#calculate how many refuels are needed to get initial Starship to HEO from LEO (assuming initial ship is empty)\n",
    "initial_LEO_mass = dry_mass*np.exp(DV_saved/(9.81*isp))\n",
    "extra_refuels = (initial_LEO_mass-200)/tanker_prop\n",
    "\n",
    "# p=DV_saved/(10*isp)\n",
    "Tanker_Final_Mass = (dry_mass+prop_mass)*np.exp(-DV_saved/(9.81*isp))\n",
    "No_Tanker_Refuels = refuels_per_ship*prop_mass/(Tanker_Final_Mass - dry_mass)\n",
    "No_Refuels = No_Tanker_Refuels+extra_refuels#+np.ceil(No_Tanker_Refuels/(refuels_per_ship))\n",
    "fig, ax = plt.subplots()\n",
    "ax.xaxis.set_major_locator(MaxNLocator(integer=True))\n",
    "\n",
    "ax.plot(No_Refuels,DV_saved)\n",
    "\n",
    "plt.axhline(y=2700, color='red', linestyle='dashed', label='Block 3 115t dry mass')\n",
    "plt.axhline(y=2500, color='purple', linestyle='dashed', label='Block 4 150t dry mass')\n",
    "plt.axhline(y=900, color='green', linestyle='dashed', label='Block 3 90t dry mass')\n",
    "\n",
    "\n",
    "plt.xlabel(\"Number of Refuels\")\n",
    "plt.ylabel(\"$\\Delta V$ relative to LEO (m/s)\")\n",
    "plt.title(\"Refuels vs HEO $\\Delta$V relative to LEO\")\n",
    "plt.grid(True)\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
  },
